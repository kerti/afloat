# Afloat — example environment. Copy to `.env` and edit; `.env` is gitignored.
#
# The BACKEND block below is a naming contract: both backends read these exact
# names with these exact meanings, so an operator who has configured one has
# configured the other (BOOTSTRAP.md §12). Renaming one here without renaming it
# in both backends breaks `make check`, by design.
#
# Durations use suffixes BOTH runtimes accept. Never `d`: Spring takes `30d`,
# Go's time.ParseDuration does not. That is why the caps below are in hours.

# ---------------------------------------------------------------------------
# Backend configuration — identical names in the Go and Kotlin backends
# ---------------------------------------------------------------------------

# libpq form, for both backends. The Kotlin backend translates it to a JDBC URL
# at boot rather than taking a different variable. Port 5184 is the local
# Postgres (BOOTSTRAP.md §1); the database is afloat_go or afloat_kotlin.
DATABASE_URL=postgres://afloat:afloat@localhost:5184/afloat_go

# The one default that differs by backend: 5182 Go, 5183 Kotlin. Both must be
# able to run at once, because parity work means running both at once.
PORT=5182

LOG_FORMAT=text
LOG_LEVEL=info

# Apply migrations on boot. Off only to run a server against a database
# migrated by something else.
AUTO_MIGRATE=true

HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=10s

AUTH_LOCAL_ENABLED=true
# Planned, not built (PRD §4.1).
AUTH_GOOGLE_ENABLED=false

# The sliding window, and the absolute cap measured from creation
# (BOOTSTRAP.md §5.1). 720h is 30 days; 2160h is 90.
SESSION_TTL=720h
SESSION_MAX_LIFETIME=2160h

# The login backoff (BOOTSTRAP.md §5.1): this long after the first failure,
# doubling per failure, never longer than the cap. Backoff, never a lockout.
LOGIN_FIRST_BACKOFF=1s
LOGIN_MAX_BACKOFF=5m

# Off ONLY for local development over plain HTTP. Every deployment leaves this
# on — a session cookie without Secure travels in clear.
COOKIE_SECURE=false

# Stamped at build time in a real build; reported by GET /api/health.
VERSION=dev

# ---------------------------------------------------------------------------
# Compose-level — configures the local Postgres container, not either backend
# ---------------------------------------------------------------------------
# Not part of the parity contract: no backend reads these.

AFLOAT_DB_PORT=5184
AFLOAT_DB_USER=afloat
AFLOAT_DB_PASSWORD=afloat

# ---------------------------------------------------------------------------
# Test-only
# ---------------------------------------------------------------------------
# Set to 1 to turn the integration suites' docker-missing SKIP into a FAILURE,
# in both backends. CI sets it; locally you usually want it unset so
# `make check` still works on a machine without docker running.
# AFLOAT_REQUIRE_TEST_DB=1

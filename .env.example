# Afloat — example environment. Copy to `.env` and edit; `.env` is gitignored.
#
# The BACKEND block below is documented in BOOTSTRAP.md §12, and `make check`
# holds the backend to that table: renaming one here without renaming it in
# both places breaks the gate, by design.
#
# Durations use Go's time.ParseDuration suffixes. Never `d`: it is not one.
# That is why the caps below are in hours.

# ---------------------------------------------------------------------------
# Backend configuration
# ---------------------------------------------------------------------------

# libpq form. Port 5184 is the local Postgres (BOOTSTRAP.md §1).
DATABASE_URL=postgres://afloat:afloat@localhost:5184/afloat

PORT=5182

LOG_FORMAT=text
LOG_LEVEL=info

# Apply migrations on boot. Off only to run a server against a database
# migrated by something else.
AUTO_MIGRATE=true

HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=120s
SHUTDOWN_TIMEOUT=10s

AUTH_LOCAL_ENABLED=true
# Planned, not built (PRD §4.1).
AUTH_GOOGLE_ENABLED=false

# Registration is open to anyone who reaches the instance, and the first person
# through the gate founds a Household. Found yours, then set this to true
# (BOOTSTRAP.md §12). It stops founding, not sign-in.
FOUNDING_DISABLED=false

# The sliding window, and the absolute cap measured from creation
# (BOOTSTRAP.md §5.1). 720h is 30 days; 2160h is 90.
SESSION_TTL=720h
SESSION_MAX_LIFETIME=2160h

# The login backoff (BOOTSTRAP.md §5.1): this long after the first failure,
# doubling per failure, never longer than the cap. Backoff, never a lockout.
LOGIN_FIRST_BACKOFF=1s
LOGIN_MAX_BACKOFF=5m

# Off ONLY for local development over plain HTTP. Every deployment leaves this
# on — a session cookie without Secure travels in clear.
COOKIE_SECURE=false

# Stamped at build time in a real build; reported by GET /api/health.
VERSION=dev

# ---------------------------------------------------------------------------
# Compose-level — configures the local Postgres container, not the backend
# ---------------------------------------------------------------------------
# Not in §12: the backend never reads these.

AFLOAT_DB_PORT=5184
AFLOAT_DB_USER=afloat
AFLOAT_DB_PASSWORD=afloat

# ---------------------------------------------------------------------------
# Test-only
# ---------------------------------------------------------------------------
# Set to 1 to turn the integration suite's docker-missing SKIP into a FAILURE.
# CI sets it; locally you usually want it unset so
# `make check` still works on a machine without docker running.
# AFLOAT_REQUIRE_TEST_DB=1

{
  "_comment": [
    "The dashboard's assembly, row by row (#155 R1, BOOTSTRAP.md §6): what the Period's stored rows add up to",
    "for a Household on a given instant. trajectory.json takes aggregates and so cannot pin the Period",
    "bounding, the day mapping or the folding of Expenses into them; this file does.",
    "`households` are seeded together into one database, and every `reads` row is answered for the Household",
    "it sits in, so another Household's rows being present is part of every row (tenancy). `categories`,",
    "`pockets` and `expenses` are keyed by `key` for the rows that name them; `active` defaults to true,",
    "`deleted` to false. An Expense's currency is its Household's `reporting_currency`. `captured_at` is",
    "set on some Expenses to a time that disagrees with `occurred_on` on purpose: no figure reads it.",
    "`monthly_budgets` and `allocations` are the Budget's version logs by `year_month` and `effective_on`;",
    "a Period marker is created for every `year_month` named here.",
    "A `reads` row: `now` is the instant of the request, the User's `time_zone` and the Household's",
    "`day_starts_at` make Today of it, `period` is the Period containing Today, and `expected.spend` is",
    "the daily bucket's spend in that Period: `by_day` (days with any), `settled` before Today, `today`,",
    "`future` after Today up to the Period's last day. A Commitment Category's Expense is in none of it, an",
    "uncategorised one is Daily, a deleted one is out, an inactive Category's or Pocket's counts, a refund",
    "is negative, and an Expense dated outside the Period is in no figure of it. `expected.wire` is what",
    "`GET /dashboard` carries at this stage of #155: the currency. Each later PR adds its figures to every",
    "row here (the trajectory's, the breakdowns', the chart's), so this file grows by assertions, not rows.",
    "Every expected value was added up by hand from the rows above it, not derived from the backend.",
    "Not yet asserted, and left to the PR that computes them: the Daily Pool through the Period and the",
    "figures made of it. The Budget rows below are their inputs: a Monthly Budget change on day 11 and a",
    "later one after Today, a Commitment's allocation change on day 12, a Daily Category's on day 10."
  ],
  "households": [
    {
      "name": "November, the first of the month, spend across every boundary",
      "period_start_day": 1,
      "reporting_currency": "IDR",
      "time_zone": "Asia/Jakarta",
      "day_starts_at": "04:00",
      "categories": [
        {"key": "food", "name": "Food", "bucket": "daily"},
        {"key": "snacks", "name": "Snacks", "bucket": "daily", "active": false},
        {"key": "rent", "name": "Rent", "bucket": "commitment"}
      ],
      "pockets": [
        {"key": "wallet", "name": "Wallet"},
        {"key": "old-card", "name": "Old card", "active": false}
      ],
      "expenses": [
        {"key": "day before the window", "occurred_on": "2026-10-31", "amount": "7000", "pocket": "wallet", "category": "food", "captured_at": "2026-11-14T00:00:00Z"},
        {"key": "first day", "occurred_on": "2026-11-01", "amount": "10000", "pocket": "wallet", "category": "food"},
        {"key": "uncategorised is Daily", "occurred_on": "2026-11-05", "amount": "20000", "pocket": "wallet"},
        {"key": "a refund", "occurred_on": "2026-11-06", "amount": "-5000", "pocket": "wallet", "category": "food"},
        {"key": "a Commitment", "occurred_on": "2026-11-07", "amount": "3000000", "pocket": "wallet", "category": "rent"},
        {"key": "deleted", "occurred_on": "2026-11-08", "amount": "99000", "pocket": "wallet", "category": "food", "deleted": true},
        {"key": "inactive Category and Pocket", "occurred_on": "2026-11-09", "amount": "4000", "pocket": "old-card", "category": "snacks"},
        {"key": "two on one day, one", "occurred_on": "2026-11-13", "amount": "30000", "pocket": "wallet", "category": "food"},
        {"key": "two on one day, two", "occurred_on": "2026-11-13", "amount": "12000", "pocket": "wallet", "category": "snacks"},
        {"key": "today, captured much later", "occurred_on": "2026-11-14", "amount": "15000", "pocket": "wallet", "category": "food", "captured_at": "2026-12-30T10:00:00Z"},
        {"key": "today, uncategorised", "occurred_on": "2026-11-14", "amount": "25000", "pocket": "wallet"},
        {"key": "future", "occurred_on": "2026-11-15", "amount": "50000", "pocket": "wallet", "category": "food"},
        {"key": "future refund", "occurred_on": "2026-11-20", "amount": "-8000", "pocket": "wallet", "category": "food"},
        {"key": "the Period's last day", "occurred_on": "2026-11-30", "amount": "60000", "pocket": "wallet", "category": "food"},
        {"key": "the day after the window", "occurred_on": "2026-12-01", "amount": "111000", "pocket": "wallet", "category": "food", "captured_at": "2026-11-01T00:00:00Z"}
      ],
      "monthly_budgets": [
        {"year_month": "2026-11", "effective_on": "2026-11-01", "monthly_budget": "6000000"},
        {"year_month": "2026-11", "effective_on": "2026-11-11", "monthly_budget": "7500000"},
        {"year_month": "2026-11", "effective_on": "2026-11-20", "monthly_budget": "6500000"}
      ],
      "allocations": [
        {"year_month": "2026-11", "effective_on": "2026-11-01", "category": "rent", "allocation": "2000000"},
        {"year_month": "2026-11", "effective_on": "2026-11-10", "category": "food", "allocation": "1500000"},
        {"year_month": "2026-11", "effective_on": "2026-11-12", "category": "rent", "allocation": "2500000"}
      ],
      "reads": [
        {
          "name": "Today is the 14th at exactly 04:00",
          "now": "2026-11-14T04:00:00+07:00",
          "expected": {"today": "2026-11-14", "period": {"year_month": "2026-11", "starts_on": "2026-11-01", "ends_on": "2026-11-30"}, "spend": {"by_day": {"2026-11-01": "10000.0000", "2026-11-05": "20000.0000", "2026-11-06": "-5000.0000", "2026-11-09": "4000.0000", "2026-11-13": "42000.0000", "2026-11-14": "40000.0000", "2026-11-15": "50000.0000", "2026-11-20": "-8000.0000", "2026-11-30": "60000.0000"}, "settled": "71000.0000", "today": "40000.0000", "future": "102000.0000"}, "wire": {"currency": "IDR"}}
        },
        {
          "name": "one second earlier it is still the 13th, so the 13th's spend is Today's and the 14th's is future",
          "now": "2026-11-14T03:59:59+07:00",
          "expected": {"today": "2026-11-13", "period": {"year_month": "2026-11", "starts_on": "2026-11-01", "ends_on": "2026-11-30"}, "spend": {"by_day": {"2026-11-01": "10000.0000", "2026-11-05": "20000.0000", "2026-11-06": "-5000.0000", "2026-11-09": "4000.0000", "2026-11-13": "42000.0000", "2026-11-14": "40000.0000", "2026-11-15": "50000.0000", "2026-11-20": "-8000.0000", "2026-11-30": "60000.0000"}, "settled": "29000.0000", "today": "42000.0000", "future": "142000.0000"}, "wire": {"currency": "IDR"}}
        },
        {
          "name": "the first day: nothing is settled",
          "now": "2026-11-01T04:00:00+07:00",
          "expected": {"today": "2026-11-01", "period": {"year_month": "2026-11", "starts_on": "2026-11-01", "ends_on": "2026-11-30"}, "spend": {"by_day": {"2026-11-01": "10000.0000", "2026-11-05": "20000.0000", "2026-11-06": "-5000.0000", "2026-11-09": "4000.0000", "2026-11-13": "42000.0000", "2026-11-14": "40000.0000", "2026-11-15": "50000.0000", "2026-11-20": "-8000.0000", "2026-11-30": "60000.0000"}, "settled": "0.0000", "today": "10000.0000", "future": "203000.0000"}, "wire": {"currency": "IDR"}}
        },
        {
          "name": "the last day: nothing is future",
          "now": "2026-11-30T10:00:00+07:00",
          "expected": {"today": "2026-11-30", "period": {"year_month": "2026-11", "starts_on": "2026-11-01", "ends_on": "2026-11-30"}, "spend": {"by_day": {"2026-11-01": "10000.0000", "2026-11-05": "20000.0000", "2026-11-06": "-5000.0000", "2026-11-09": "4000.0000", "2026-11-13": "42000.0000", "2026-11-14": "40000.0000", "2026-11-15": "50000.0000", "2026-11-20": "-8000.0000", "2026-11-30": "60000.0000"}, "settled": "153000.0000", "today": "60000.0000", "future": "0.0000"}, "wire": {"currency": "IDR"}}
        },
        {
          "name": "the next Period holds only what is dated in it",
          "now": "2026-12-01T10:00:00+07:00",
          "expected": {"today": "2026-12-01", "period": {"year_month": "2026-12", "starts_on": "2026-12-01", "ends_on": "2026-12-31"}, "spend": {"by_day": {"2026-12-01": "111000.0000"}, "settled": "0.0000", "today": "111000.0000", "future": "0.0000"}, "wire": {"currency": "IDR"}}
        }
      ]
    },
    {
      "name": "A Household that starts its Period on the 25th, in dollars, with no Monthly Budget and no Category",
      "period_start_day": 25,
      "reporting_currency": "USD",
      "time_zone": "Asia/Jakarta",
      "day_starts_at": "04:00",
      "categories": [],
      "pockets": [
        {"key": "wallet", "name": "Wallet"}
      ],
      "expenses": [
        {"key": "before the window", "occurred_on": "2026-11-24", "amount": "5000", "pocket": "wallet"},
        {"key": "first day", "occurred_on": "2026-11-25", "amount": "10000", "pocket": "wallet"},
        {"key": "today", "occurred_on": "2026-11-26", "amount": "20000", "pocket": "wallet"},
        {"key": "the Period's last day", "occurred_on": "2026-12-24", "amount": "30000", "pocket": "wallet"},
        {"key": "after the window", "occurred_on": "2026-12-25", "amount": "40000", "pocket": "wallet"}
      ],
      "monthly_budgets": [],
      "allocations": [],
      "reads": [
        {
          "name": "the 26th, inside November's Period of the 25th",
          "now": "2026-11-26T10:00:00+07:00",
          "expected": {"today": "2026-11-26", "period": {"year_month": "2026-11", "starts_on": "2026-11-25", "ends_on": "2026-12-24"}, "spend": {"by_day": {"2026-11-25": "10000.0000", "2026-11-26": "20000.0000", "2026-12-24": "30000.0000"}, "settled": "10000.0000", "today": "20000.0000", "future": "30000.0000"}, "wire": {"currency": "USD"}}
        },
        {
          "name": "the 24th still belongs to October's Period",
          "now": "2026-11-24T10:00:00+07:00",
          "expected": {"today": "2026-11-24", "period": {"year_month": "2026-10", "starts_on": "2026-10-25", "ends_on": "2026-11-24"}, "spend": {"by_day": {"2026-11-24": "5000.0000"}, "settled": "0.0000", "today": "5000.0000", "future": "0.0000"}, "wire": {"currency": "USD"}}
        }
      ]
    }
  ]
}

{
  "description": "Pins the order of GET /expenses (#140 R7) and where a keyset page may end. Newest first: occurred_on DESC, then the effective time DESC, then captured_at DESC, then id DESC. The effective time is an offset into the Period Day, (t - day_starts_at) mod 24h: occurred_time when set; else, when the Expense was captured on that same Period Day (its wall clock in the caller's zone, less day_starts_at, as a date), the capture's time of day; else the start of the day (offset 00:00). So with a 04:00 start 01:30 sorts AFTER 23:00. Rows are names in `order`, newest first; a row's id is the integer n written as the last digits of a UUIDv7, so `id DESC` is `n DESC`. `deleted` rows and rows of the `other` Household are never listed. The backend's test reads every scenario row by row, and walks every page size from 1 to the row count (and the explicit `pages`) asserting no row is repeated or skipped.",
  "scenarios": [
    {
      "name": "Jakarta (UTC+7), 04:00 start: every branch of the effective time",
      "time_zone": "Asia/Jakarta",
      "day_starts_at": "04:00",
      "rows": [
        {"n": 1, "name": "newest day", "occurred_on": "2026-11-24", "captured_at": "2026-11-24T05:00:00Z"},
        {"n": 2, "name": "01:30 given", "occurred_on": "2026-11-23", "occurred_time": "01:30", "captured_at": "2026-11-23T05:00:00Z"},
        {"n": 3, "name": "23:00 given", "occurred_on": "2026-11-23", "occurred_time": "23:00", "captured_at": "2026-11-23T05:00:00Z"},
        {"n": 4, "name": "captured 02:00 next morning", "occurred_on": "2026-11-23", "captured_at": "2026-11-23T19:00:00Z"},
        {"n": 5, "name": "captured 10:00", "occurred_on": "2026-11-23", "captured_at": "2026-11-23T03:00:00Z"},
        {"n": 6, "name": "back-dated, captured later", "occurred_on": "2026-11-23", "captured_at": "2026-11-25T05:00:00Z"},
        {"n": 7, "name": "04:00 given", "occurred_on": "2026-11-23", "occurred_time": "04:00", "captured_at": "2026-11-20T05:00:00Z"},
        {"n": 8, "name": "older day", "occurred_on": "2026-11-22", "occurred_time": "23:59", "captured_at": "2026-11-21T05:00:00Z"},
        {"n": 9, "name": "deleted", "occurred_on": "2026-11-24", "captured_at": "2026-11-24T06:00:00Z", "deleted": true},
        {"n": 90, "name": "another Household's", "occurred_on": "2026-11-25", "captured_at": "2026-11-25T06:00:00Z", "other": true}
      ],
      "order": [
        "newest day",
        "captured 02:00 next morning",
        "01:30 given",
        "23:00 given",
        "captured 10:00",
        "back-dated, captured later",
        "04:00 given",
        "older day"
      ],
      "pages": [
        {"limit": 3, "pages": [
          ["newest day", "captured 02:00 next morning", "01:30 given"],
          ["23:00 given", "captured 10:00", "back-dated, captured later"],
          ["04:00 given", "older day"]
        ]}
      ]
    },
